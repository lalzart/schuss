  palWritePad(GPIOG,6, channel == 1);
  palWritePad(GPIOC,6, channel == 2);
  palWritePad(GPIOB,3, channel == 3);
  palWritePad(GPIOB,4, channel == 4);
  palWritePad(GPIOB,6, channel == 5);
  palWritePad(GPIOB,7, channel == 6);
}

