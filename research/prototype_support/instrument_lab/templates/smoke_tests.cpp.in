#include "@NAMESPACE@/smoke_adapter.hpp"
#include "schuss/instrument_lab/renderer_artifacts.hpp"
#include "schuss/instrument_lab/ui_projection.hpp"

#include <array>
#include <cmath>
#include <cstdint>
#include <cstdlib>
#include <iostream>

int main() {
    @NAMESPACE@::Host host;
    const std::array<std::uint8_t, 3> message{{0xb0, 1, 64}};
    const auto envelope = schuss::instrument_lab::makeRawMidiEnvelope(
        message.data(), 3, 99, 7, 1);
    if (envelope.sample_offset != 6 || !host.adapter().accept(envelope)) return EXIT_FAILURE;
    std::array<float, 7> left{};
    std::array<float, 7> right{};
    host.process(left.data(), right.data(), 7);
    const auto snapshot = host.adapter().snapshot();
    if (snapshot.accepted_events != 1 || std::abs(left[0] - 64.0f / 127.0f) > 1e-7f) return EXIT_FAILURE;
    const std::array<int, 1> descriptor{{0}};
    const auto ui = schuss::instrument_lab::projectControlValues(
        descriptor, snapshot, [](int, const @NAMESPACE@::Snapshot& state) noexcept {
            return state.accepted_value;
        });
    if (ui[0] != snapshot.accepted_value) return EXIT_FAILURE;
    if (schuss::instrument_lab::sha256("smoke") !=
        "04d588cb41b8022d1233924f0fe8280d9e2bb92cdc81658eb102ef9c42fc9452") return EXIT_FAILURE;
    host.reset();
    if (host.adapter().snapshot().resets != 1) return EXIT_FAILURE;
    std::cout << "non-musical Instrument Lab smoke passed\n";
    return EXIT_SUCCESS;
}
