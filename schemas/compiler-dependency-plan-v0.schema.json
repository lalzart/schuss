{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "compiler-dependency-plan-v0.schema.json",
  "title": "Schuss dependency plan v0",
  "type": "object",
  "required": ["schema_version", "canonical_profile", "derived", "input_closure_hash", "ordering_policy", "ordered_dependency_ids", "dependencies", "exclusive_services", "cycles", "limitations"],
  "properties": {
    "schema_version": {"const": "compiler-dependency-plan-v0"},
    "canonical_profile": {"const": "schuss-canonical-json-v1"},
    "derived": {"const": true},
    "input_closure_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "ordering_policy": {"const": "dependency-topological-v1"},
    "ordered_dependency_ids": {"type": "array", "x-schuss-array-kind": "sequence", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}},
    "dependencies": {"type": "array", "x-schuss-array-kind": "sequence", "items": {"$ref": "#/$defs/dependency"}},
    "exclusive_services": {"type": "array", "x-schuss-array-kind": "sequence", "items": {"$ref": "#/$defs/exclusiveService"}},
    "cycles": {"type": "array", "x-schuss-array-kind": "sequence", "items": {"$ref": "#/$defs/cycle"}},
    "limitations": {"type": "array", "x-schuss-array-kind": "set", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false,
  "$defs": {
    "contentHash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "bindingReference": {"type": "object", "required": ["implementation_id", "revision", "content_hash"], "properties": {"implementation_id": {"type": "string", "pattern": "^schuss-implementation-[0-9]{6}$"}, "revision": {"type": "integer", "minimum": 1}, "content_hash": {"$ref": "#/$defs/contentHash"}}, "additionalProperties": false},
    "consumer": {"type": "object", "required": ["instance_path", "binding_reference"], "properties": {"instance_path": {"type": "array", "x-schuss-array-kind": "sequence", "items": {"type": "string", "minLength": 1}}, "binding_reference": {"$ref": "#/$defs/bindingReference"}}, "additionalProperties": false},
    "dependency": {
      "type": "object",
      "required": ["dependency_id", "portable_locators", "decision", "selected_provider_ids", "versions", "consumers"],
      "properties": {
        "dependency_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "portable_locators": {"type": "array", "x-schuss-array-kind": "set", "uniqueItems": true, "items": {"type": "string", "pattern": "^sha256/[0-9a-f]{64}$"}},
        "decision": {"enum": ["included", "missing", "unresolved", "conflict"]},
        "selected_provider_ids": {"type": "array", "x-schuss-array-kind": "set", "uniqueItems": true, "maxItems": 1, "items": {"type": "string", "pattern": "^dependency-provider-[0-9]{6}$"}},
        "versions": {"type": "array", "x-schuss-array-kind": "set", "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9]+(?:[.][0-9]+)*$"}},
        "consumers": {"type": "array", "x-schuss-array-kind": "set", "uniqueItems": true, "items": {"$ref": "#/$defs/consumer"}}
      },
      "additionalProperties": false
    },
    "exclusiveService": {"type": "object", "required": ["service_id", "dependency_ids", "provider_ids"], "properties": {"service_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}, "dependency_ids": {"type": "array", "x-schuss-array-kind": "set", "uniqueItems": true, "minItems": 2, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}}, "provider_ids": {"type": "array", "x-schuss-array-kind": "set", "uniqueItems": true, "minItems": 2, "items": {"type": "string", "pattern": "^dependency-provider-[0-9]{6}$"}}}, "additionalProperties": false},
    "cycle": {"type": "object", "required": ["dependency_ids"], "properties": {"dependency_ids": {"type": "array", "x-schuss-array-kind": "set", "uniqueItems": true, "minItems": 1, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}}}, "additionalProperties": false}
  }
}
