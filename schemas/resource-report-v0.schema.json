{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "resource-report-v0.schema.json",
  "title": "Schuss resource report v0",
  "type": "object",
  "required": ["schema_version", "canonical_profile", "resource_report_id", "revision", "content_hash", "subject_reference", "compute_target_reference", "observations", "budget_comparisons"],
  "properties": {
    "schema_version": {"const": "resource-report-v0"},
    "canonical_profile": {"const": "schuss-canonical-json-v1"},
    "resource_report_id": {"type": "string", "pattern": "^schuss-resource-report-[0-9]{6}$"},
    "revision": {"type": "integer", "minimum": 1},
    "content_hash": {"$ref": "#/$defs/contentHash"},
    "subject_reference": {"$ref": "#/$defs/subjectReference"},
    "compute_target_reference": {"$ref": "#/$defs/targetReference"},
    "observations": {"type": "array", "x-schuss-array-kind": "set", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/observation"}},
    "budget_comparisons": {"type": "array", "x-schuss-array-kind": "set", "uniqueItems": true, "items": {"$ref": "#/$defs/budgetComparison"}}
  },
  "additionalProperties": false,
  "$defs": {
    "contentHash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "targetReference": {"type": "object", "required": ["compute_target_id", "revision", "content_hash"], "properties": {"compute_target_id": {"type": "string", "pattern": "^schuss-compute-target-[0-9]{6}$"}, "revision": {"type": "integer", "minimum": 1}, "content_hash": {"$ref": "#/$defs/contentHash"}}, "additionalProperties": false},
    "subjectReference": {
      "type": "object",
      "required": ["subject_kind", "stable_id", "revision", "content_hash"],
      "properties": {"subject_kind": {"enum": ["implementation-binding", "dsp-graph", "build-request", "build-result", "artifact"]}, "stable_id": {"type": "string", "pattern": "^schuss-[a-z0-9-]+-[0-9]{6}$"}, "revision": {"type": "integer", "minimum": 1}, "content_hash": {"$ref": "#/$defs/contentHash"}},
      "additionalProperties": false
    },
    "knownObservation": {
      "type": "object",
      "required": ["observation_id", "observation_kind", "resource_kind", "region_id", "amount_bytes", "alignment_bytes", "unit", "method", "evidence_level"],
      "properties": {
        "observation_id": {"type": "string", "pattern": "^resource-observation-[0-9]{6}$"},
        "observation_kind": {"enum": ["hard-declared-requirement", "static-estimate", "compiler-link-map-observation", "connected-runtime-measurement"]},
        "resource_kind": {"enum": ["code", "read-only-data", "data", "stack", "heap", "asset", "cpu-load", "timing", "io-stability"]},
        "region_id": {"type": "string", "pattern": "^target-memory-region-[0-9]{6}$"},
        "amount_bytes": {"type": "integer", "minimum": 0},
        "alignment_bytes": {"type": "integer", "minimum": 1},
        "unit": {"const": "bytes"},
        "method": {"enum": ["binding-declaration", "static-analysis", "compiler-link-map", "connected-runtime-probe"]},
        "evidence_level": {"type": "integer", "minimum": 1, "maximum": 8}
      },
      "additionalProperties": false
    },
    "unknownObservation": {
      "type": "object",
      "required": ["observation_id", "observation_kind", "resource_kind", "region_id", "unit", "code", "method", "owner", "earliest_task", "question", "rationale"],
      "properties": {
        "observation_id": {"type": "string", "pattern": "^resource-observation-[0-9]{6}$"},
        "observation_kind": {"enum": ["unresolved", "not-evaluated"]},
        "resource_kind": {"enum": ["code", "read-only-data", "data", "stack", "heap", "asset", "cpu-load", "timing", "io-stability"]},
        "region_id": {"type": "string", "pattern": "^target-memory-region-[0-9]{6}$"},
        "unit": {"const": "bytes"},
        "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
        "method": {"const": "not-performed"},
        "owner": {"enum": ["target-owner", "backend-owner", "evidence-owner"]},
        "earliest_task": {"type": "string", "pattern": "^task-[0-9]{3}$"},
        "question": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "observation": {"oneOf": [{"$ref": "#/$defs/knownObservation"}, {"$ref": "#/$defs/unknownObservation"}]},
    "budgetComparison": {
      "type": "object",
      "required": ["comparison_id", "observation_ids", "region_id", "budget_bytes", "total_aligned_amount_bytes", "outcome"],
      "properties": {
        "comparison_id": {"type": "string", "pattern": "^resource-comparison-[0-9]{6}$"},
        "observation_ids": {"type": "array", "x-schuss-array-kind": "set", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^resource-observation-[0-9]{6}$"}},
        "region_id": {"type": "string", "pattern": "^target-memory-region-[0-9]{6}$"},
        "budget_bytes": {"type": "integer", "minimum": 0},
        "total_aligned_amount_bytes": {"type": "integer", "minimum": 0},
        "outcome": {"enum": ["within-budget", "equal-to-budget", "overflow", "unresolved"]}
      },
      "additionalProperties": false
    }
  }
}
