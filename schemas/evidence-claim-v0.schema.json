{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence-claim-v0.schema.json",
  "title": "Schuss level-specific evidence claim v0",
  "type": "object",
  "required": ["schema_version", "canonical_profile", "evidence_claim_id", "revision", "content_hash", "level", "level_name", "subject_reference", "method", "outcome", "evidence_inputs", "limitations", "producer_identity"],
  "properties": {
    "schema_version": {"const": "evidence-claim-v0"},
    "canonical_profile": {"const": "schuss-canonical-json-v1"},
    "evidence_claim_id": {"type": "string", "pattern": "^schuss-evidence-claim-[0-9]{6}$"},
    "revision": {"type": "integer", "minimum": 1},
    "content_hash": {"$ref": "#/$defs/contentHash"},
    "level": {"type": "integer", "minimum": 1, "maximum": 8},
    "level_name": {"enum": ["structural-schema-validation", "component-graph-resolution", "backend-lowering", "source-artifact-generation", "arm-compilation-linking", "connected-device-execution", "real-time-resource-validation", "audible-listening-validation"]},
    "subject_reference": {"$ref": "#/$defs/subjectReference"},
    "method": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "outcome": {"enum": ["passed", "failed", "observed"]},
    "evidence_inputs": {"type": "array", "x-schuss-array-kind": "set", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/inputReference"}},
    "limitations": {"type": "array", "x-schuss-array-kind": "set", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "producer_identity": {"$ref": "#/$defs/producerIdentity"}
  },
  "additionalProperties": false,
  "$defs": {
    "contentHash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "subjectReference": {
      "type": "object",
      "required": ["subject_kind", "stable_id", "revision", "content_hash", "stage"],
      "properties": {
        "subject_kind": {"enum": ["semantic-record", "build-result", "build-stage", "artifact", "compute-target", "device-profile", "instrument", "resource-report"]},
        "stable_id": {"type": "string", "pattern": "^schuss-[a-z0-9-]+-[0-9]{6}$"},
        "revision": {"type": "integer", "minimum": 1},
        "content_hash": {"$ref": "#/$defs/contentHash"},
        "stage": {"enum": ["not-applicable", "schema-identity-validation", "target-independent-graph-validation", "target-backend-validation", "implementation-resolution", "compound-elaboration", "dependency-resource-planning", "backend-lowering", "artifact-generation", "target-compile-link", "packaging-evidence-recording", "connected-device-execution", "real-time-resource-validation", "audible-listening-validation"]}
      },
      "additionalProperties": false
    },
    "inputReference": {
      "type": "object",
      "required": ["input_kind", "stable_id", "revision", "content_hash"],
      "properties": {
        "input_kind": {"enum": ["semantic-record", "build-request", "build-result", "artifact", "compute-target", "device-profile", "instrument", "resource-report", "procedure"]},
        "stable_id": {"type": "string", "pattern": "^schuss-[a-z0-9-]+-[0-9]{6}$"},
        "revision": {"type": "integer", "minimum": 1},
        "content_hash": {"$ref": "#/$defs/contentHash"}
      },
      "additionalProperties": false
    },
    "producerIdentity": {
      "type": "object",
      "required": ["producer_kind", "producer_id", "version", "content_hash"],
      "properties": {
        "producer_kind": {"enum": ["validator", "backend", "toolchain", "device-procedure", "measurement-procedure", "listening-procedure"]},
        "producer_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "version": {"type": "string", "minLength": 1},
        "content_hash": {"$ref": "#/$defs/contentHash"}
      },
      "additionalProperties": false
    }
  }
}
