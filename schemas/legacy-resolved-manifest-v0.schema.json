{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "legacy-resolved-manifest-v0.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "exporter",
    "legacy_runtime",
    "raw_snapshot",
    "sources",
    "object_roots",
    "graph_input_types",
    "options"
  ],
  "properties": {
    "schema_version": {"const": "legacy-resolved-catalog-v0"},
    "exporter": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "legacy_runtime": {
      "type": "object",
      "required": ["source_id", "commit", "classpath_fingerprint_sha256", "java_version"],
      "properties": {
        "source_id": {"$ref": "#/$defs/sourceId"},
        "commit": {"$ref": "#/$defs/commit"},
        "classpath_fingerprint_sha256": {"$ref": "#/$defs/sha256"},
        "java_version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "raw_snapshot": {
      "type": "object",
      "required": ["schema_version", "manifest_sha256", "files_jsonl_sha256"],
      "properties": {
        "schema_version": {"const": "legacy-catalog-v0"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "files_jsonl_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "url", "commit", "observed_dirty"],
        "properties": {
          "id": {"$ref": "#/$defs/sourceId"},
          "url": {"type": "string", "minLength": 1},
          "commit": {"$ref": "#/$defs/commit"},
          "observed_dirty": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "object_roots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["order", "source_id", "relative_path"],
        "properties": {
          "order": {"type": "integer", "minimum": 0},
          "source_id": {"$ref": "#/$defs/sourceId"},
          "relative_path": {"$ref": "#/$defs/portablePath"}
        },
        "additionalProperties": false
      }
    },
    "graph_input_types": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"enum": ["axs", "axp"]},
      "allOf": [
        {"contains": {"const": "axs"}},
        {"contains": {"const": "axp"}}
      ]
    },
    "options": {
      "type": "object",
      "required": [
        "phase",
        "timestamp_included",
        "preference_writes",
        "subpatch_interface_projection",
        "target_artifact_generation",
        "target_compilation",
        "device_access"
      ],
      "properties": {
        "phase": {"const": "java-resolved"},
        "timestamp_included": {"const": false},
        "preference_writes": {"const": false},
        "subpatch_interface_projection": {"const": true},
        "target_artifact_generation": {"const": false},
        "target_compilation": {"const": false},
        "device_access": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "sourceId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "portablePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    }
  },
  "additionalProperties": false
}
