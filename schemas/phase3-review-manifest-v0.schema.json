{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schuss.local/schemas/phase3-review-manifest-v0.schema.json",
  "title": "Schuss Phase 3 inventory review manifest v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generator",
    "input_snapshot",
    "sample_selection",
    "impact_policy_version",
    "options",
    "generated_files"
  ],
  "properties": {
    "schema_version": {"const": "phase3-inventory-review-v0"},
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "build_phase3_review_packet.py"},
        "version": {"type": "integer", "minimum": 1}
      }
    },
    "input_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "files"],
      "properties": {
        "schema_version": {"const": "legacy-resolved-catalog-v0"},
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/fileHash"}
        }
      }
    },
    "sample_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "seed", "sample_size"],
      "properties": {
        "method": {"const": "sha256-rank-v1"},
        "seed": {"const": "schuss-phase3-inventory-review-v0"},
        "sample_size": {"const": 25}
      }
    },
    "impact_policy_version": {"const": "phase3-review-impact-v0"},
    "options": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_mutation", "timestamp_included", "random_runtime_values"],
      "properties": {
        "snapshot_mutation": {"const": false},
        "timestamp_included": {"const": false},
        "random_runtime_values": {"const": false}
      }
    },
    "generated_files": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/fileHash"}
    }
  },
  "$defs": {
    "fileHash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
